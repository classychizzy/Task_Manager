    {
      "name": "projects",
      "item": [
        {
          "name": "create project",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "// Only run other tests if we got a 201 response",
                  "if (pm.response.code === 201) {",
                  "    pm.test(\"Response body is valid JSON\", function () {",
                  "        pm.response.to.be.json;",
                  "    });",
                  "    ",
                  "    const response = pm.response.json();",
                  "    ",
                  "    pm.test(\"project name matches request\", function () {",
                  "        pm.expect(response.data.name).to.eql(\"Prepare API tests\");",
                  "    });",
                  "    ",
                  "    pm.test(\"project belongs to authenticated user\", function () {",
                  "        pm.expect(response.data).to.have.property(\"user\");",
                  "    });",
                  "    ",
                  "    pm.test(\"Created project is not deleted\", function () {",
                  "        pm.expect(response.data.is_deleted).to.eql(false);",
                  "    });",
                  "} else {",
                  "    console.log(\"Request failed with status:\", pm.response.code);",
                  "    console.log(\"Response:\", pm.response.text());",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
