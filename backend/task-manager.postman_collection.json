        {
          "name": "bulk user registeration",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Parse the response",
                  "const response = pm.response.json();",
                  "",
                  "// Log the result for each iteration",
                  "if (response.status === 'success') {",
                  "    console.log(`✅ User created: ${pm.iterationData.get(\"email\")}`);",
                  "} else {",
                  "    console.log(`❌ Failed to create: ${pm.iterationData.get(\"email\")} - ${response.message}`);",
                  "}",
                  "",
                  "// Test assertions",
                  "pm.test(\"Status code is 201 or 200\", function () {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test(\"User created successfully\", function () {",
                  "    pm.expect(response.status).to.eql(\"success\");",
                  "});",
                  "",
                  "pm.test(\"Response has data\", function () {",
                  "    pm.expect(response.data).to.not.be.null;",
                  "});",
                  "",
                  "// Optional: Save the last created user's info",
                  "if (response.data && response.data.user_id) {",
                  "    pm.environment.set(\"lastUserId\", response.data.user_id);",
                  "    pm.environment.set(\"lastUserEmail\", response.data.email);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
