{
  "name": "task_manager",
  "version": "1.0.0",
  "main": "server.ts",
  "nodemonConfig": {
    "watch": [
      "server"
    ],
    "ext": "ts",
    "ignore": [
      "*.test.ts"
    ],
    "delay": 3000,
    "execMap": {
      "ts": "ts-node"
    }
  },
  "scripts": {
    "start": "nodemon --max_old_space_size=4096 dist/server.js",
    "serve": "node --max_old_space_size=4096 dist/server.js",
    "dev": "nodemon --exec ts-node --legacy-watch src/server.ts",
    "build": "rimraf ./dist && tsc",
    "test": "NODE_ENV=test jest --runInBand",
    "test:watch": "NODE_ENV=test jest --watch --runInBand",
    "test:coverage": "NODE_ENV=test jest --coverage --runInBand",
    "trace-deprecation": "NODE_OPTIONS=--trace-deprecation",
    "tsc": "tsc",
    "watch-node": "nodemon --max_old_space_size=4096 dist/server.js",
    "seed:users": "tsx src/scripts/seedUsers.ts",
    "seed:tasks": "tsx src/scripts/seedTasks.ts",
    "seed:projects": "tsx src/scripts/seedProjects.ts",
    "seed:all": "npm run seed:users && npm run seed:projects && npm run seed:tasks"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "envalid": "^8.1.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "postman-to-openapi": "^1.7.3",
    "reflect-metadata": "^0.2.2",
    "save-dev": "^0.0.1-security",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.7.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/typescript": "^0.4.29",
    "@types/validator": "^13.15.3",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "rimraf": "^5.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
